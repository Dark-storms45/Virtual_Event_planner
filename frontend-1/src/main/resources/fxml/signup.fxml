<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" prefHeight="400.0" prefWidth="600.0" fx:controller="com.eventplanner.controllers.SignupController">
    <children>
        <Label layoutX="250.0" layoutY="20.0" text="Sign Up" textAlignment="CENTER">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="usernameField" layoutX="200.0" layoutY="80.0" promptText="Username" />
        <PasswordField fx:id="passwordField" layoutX="200.0" layoutY="120.0" promptText="Password" />
        <PasswordField fx:id="confirmPasswordField" layoutX="200.0" layoutY="160.0" promptText="Confirm Password" />
        <Button layoutX="250.0" layoutY="220.0" text="Sign Up" onAction="#handleSignup" />
        <Label fx:id="errorMessage" layoutX="200.0" layoutY="260.0" textFill="red" />
    </children>
</AnchorPane>